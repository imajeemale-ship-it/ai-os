[Unit]
Description=AI-OS Telegram Paper Trading Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-os
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/.johnny5_telegram_env
ExecStart=/home/ubuntu/ai-os/.venv/bin/python -m ai_os.telegram_control
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.ai-os

[Install]
WantedBy=multi-user.target
