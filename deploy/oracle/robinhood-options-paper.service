[Unit]
Description=AI-OS Robinhood Options Paper Cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-os
Environment=PYTHONUNBUFFERED=1
Environment=AI_OS_DB=/home/ubuntu/.ai-os/ai_os.db
EnvironmentFile=-/home/ubuntu/.ai-os/secrets/alpaca.env
ExecStart=/home/ubuntu/ai-os/.venv/bin/python -m ai_os robinhood-options-paper --provider alpaca --symbol SPY,QQQ,AAPL --save-report
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.ai-os

[Install]
WantedBy=multi-user.target
